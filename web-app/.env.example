# Google sign-in for /admin (see src/admin/authConfig.ts and docs/DEPLOYMENT.md). Leave the client
# id empty in development to skip sign-in. Production builds always require it. The API enforces
# its own allowlist via ZJOURNAL_GOOGLE_CLIENT_ID / ZJOURNAL_ADMIN_EMAILS (server/node).
REACT_APP_GOOGLE_CLIENT_ID=
# Optional, comma-separated. Only used to show a friendlier "not an admin" message.
REACT_APP_ADMIN_EMAILS=

# Where the API backend (server/node, server/php, server/java, or server/python) listens.
# Unset by default — src/properties.js then falls back to the page's own hostname on port 8080
# (e.g. the app served from http://192.168.0.198 talks to http://192.168.0.198:8080), so this is
# only needed when the API isn't co-located with web-app.
# REACT_APP_SERVER_URL=http://localhost:8080

# Where the standalone analytics service (../analytics) listens; article views are reported
# here. Unset by default — src/properties.js falls back to the page's own hostname on port 4400,
# same reasoning as REACT_APP_SERVER_URL above.
# REACT_APP_ANALYTICS_URL=http://localhost:4400
