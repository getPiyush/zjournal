# Port the dev server listens on.
PORT=3002

# Where the zjournalUiLibrary Module Federation remote serves remoteEntry.js.
# In dev this is `ui-library`'s "npm run mfe:start" (port 3001); in
# production point this at wherever ui-library's dist-mfe/ is hosted.
REMOTE_UI_LIBRARY_URL=http://localhost:3001

# Same zJournal backend that web-app (localhost/web) talks to.
SERVER_URL=http://localhost:8080

# Where the standalone analytics service (../analytics) listens; article views are reported
# here. Defaults to the page's own host on port 4400 at runtime if unset (see properties.ts).
ANALYTICS_URL=http://localhost:4400
