{
  "name": "@zjournal/patrikaz",
  "version": "0.1.0",
  "private": true,
  "description": "Patrikaz - independent, pluggable web reader app that consumes @zjournal/ui-library as a Module Federation remote",
  "main": "src/index.tsx",
  "scripts": {
    "start": "concurrently \"npm run mfe:start\" \"npm run server:dev\" \"npm run serve\"",
    "start:host": "concurrently \"npm run mfe:start:host\" \"npm run server:dev:host\" \"npm run serve:host\"",
    "start:server": "node scripts/start-with-server.js",
    "start:php": "npm run start:server -- php",
    "start:java": "npm run start:server -- java",
    "start:python": "npm run start:server -- python",
    "start:php:host": "npm run start:server -- php --host",
    "start:java:host": "npm run start:server -- java --host",
    "start:python:host": "npm run start:server -- python --host",
    "serve": "webpack serve --config webpack.config.js --mode development",
    "serve:host": "webpack serve --config webpack.config.js --mode development --host 0.0.0.0",
    "mfe:start": "cd ../ui-library && npm run mfe:start",
    "mfe:start:host": "cd ../ui-library && npm run mfe:start:host",
    "server:dev": "cd ../server/node && node server.js -w --development",
    "server:dev:host": "cd ../server/node && node server.js -w --development",
    "server:node:dev": "npm run server:dev",
    "server:node:dev:host": "npm run server:dev:host",
    "server:php:dev": "cd ../server/php && php -S localhost:8080",
    "server:php:dev:host": "cd ../server/php && php -S 0.0.0.0:8080",
    "server:java:dev": "cd ../server/java && ./mvnw spring-boot:run",
    "server:java:dev:host": "cd ../server/java && ./mvnw spring-boot:run -Dspring-boot.run.arguments=--server.address=0.0.0.0",
    "server:python:dev": "cd ../server/python && .venv/bin/uvicorn app.main:app --port 8080 --reload",
    "server:python:dev:host": "cd ../server/python && .venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8080 --reload",
    "build": "webpack build --config webpack.config.js --mode production",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.21.2"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@types/crypto-js": "^4.2.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "babel-loader": "^9.2.1",
    "concurrently": "^9.2.4",
    "copy-webpack-plugin": "^12.0.2",
    "css-loader": "^6.11.0",
    "dotenv": "^16.4.5",
    "html-webpack-plugin": "^5.6.0",
    "style-loader": "^3.3.4",
    "typescript": "^5.4.5",
    "webpack": "^5.109.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.2"
  }
}
