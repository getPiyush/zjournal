{
  "name": "@zjournal/analytics",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone analytics ingestion API for zJournal - records per-application article/author view events with timestamp and best-effort geolocation, persisted to a JSON store.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:host": "cross-env HOST=0.0.0.0 node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:host": "cross-env HOST=0.0.0.0 node --watch src/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "express": "^4.19.2",
    "geoip-lite": "^2.0.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
