{
  "name": "zjournal",
  "version": "1.0.0",
  "private": true,
  "description": "zJournal - A React TS based journal editor application (monorepo root)",
  "keywords": [
    "typescript",
    "react",
    "starter"
  ],
  "workspaces": [
    "ui-library",
    "web-app"
  ],
  "devDependencies": {
    "concurrently": "^9.2.4",
    "json-server": "^0.17.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.21.2"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix patrikaz && npm install --prefix analytics && npm run server:java:build",
    "stop": "lsof -ti :80,3000,3001,3002,4400,8080 | xargs kill -9 2>/dev/null; echo 'Stopped all zjournal servers (web-app, node/php/java/python backend, analytics, module federation)'",
    "patrikaz": "npm run --prefix patrikaz",
    "analytics": "npm run --prefix analytics",
    "analytics:dev": "npm run dev --prefix analytics",
    "analytics:dev:host": "npm run dev:host --prefix analytics",
    "analytics:start": "npm run start --prefix analytics",
    "analytics:start:host": "npm run start:host --prefix analytics",
    "build": "npm run build --workspace=web-app",
    "test": "npm run test --workspace=web-app --",
    "eject": "npm run eject --workspace=web-app",
    "prodrun": "npm run prodrun --workspace=web-app",
    "server:java:build": "cd server/java && ./mvnw -q -DskipTests clean package",
    "server": "node scripts/server.js",
    "dev": "node scripts/dev.js",
    "start": "node scripts/dev.js",
    "prod": "node scripts/prod.js",
    "template:auto-generate": "python3 scripts/auto_generate_template.py",
    "article-generator": "cd article-generator && .venv/bin/python -m article_generator --categories-file websites_by_category.json --db ../server/python/db.json",
    "article-generator:sync": "cd article-generator && .venv/bin/python -m article_generator.sync_db"
  }
}
