{
  "name": "zjournal",
  "version": "1.0.0",
  "private": true,
  "description": "zJournal - A React TS based journal editor application (monorepo root)",
  "keywords": [
    "typescript",
    "react",
    "starter"
  ],
  "workspaces": [
    "ui-library",
    "web-app"
  ],
  "devDependencies": {
    "concurrently": "^9.2.4",
    "json-server": "^0.17.3"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.21.2"
  },
  "scripts": {
    "install:all": "npm install && npm install --prefix patrikaz && npm run server:java:build",
    "patrikaz": "npm run --prefix patrikaz",
    "start": "npm run start --workspace=web-app",
    "build": "npm run build --workspace=web-app",
    "test": "npm run test --workspace=web-app --",
    "eject": "npm run eject --workspace=web-app",
    "prodrun": "npm run prodrun --workspace=web-app",
    "server:dev": "cd server/node && node server.js -w --development",
    "server": "cd server/node && node server.js -w --production",
    "server:node:dev": "npm run server:dev",
    "server:node:prod": "npm run server",
    "server:php:dev": "cd server/php && php -S localhost:8080",
    "server:java:dev": "cd server/java && ./mvnw spring-boot:run",
    "server:java:build": "cd server/java && ./mvnw -q -DskipTests clean package",
    "server:java:prod": "npm run server:java:build && cd server/java && java -jar target/zjournal-server-0.0.1-SNAPSHOT.jar",
    "server:python:dev": "cd server/python && .venv/bin/uvicorn app.main:app --port 8080 --reload",
    "server:python:prod": "cd server/python && .venv/bin/uvicorn app.main:app --port 8080",
    "dev": "concurrently \"npm run start\" \"npm run server:dev\"",
    "prod": "concurrently \"npm run prodrun\" \"npm run server\"",
    "dev:node": "npm run dev",
    "dev:php": "concurrently \"npm run start\" \"npm run server:php:dev\"",
    "dev:java": "concurrently \"npm run start\" \"npm run server:java:dev\"",
    "dev:python": "concurrently \"npm run start\" \"npm run server:python:dev\"",
    "prod:node": "npm run prod",
    "prod:java": "concurrently \"npm run prodrun\" \"npm run server:java:prod\"",
    "prod:python": "concurrently \"npm run prodrun\" \"npm run server:python:prod\""
  }
}
